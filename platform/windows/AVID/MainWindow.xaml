<Window
    x:Class="AVID.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="A.V.I.D. — Audio Visual Integration &amp; Distribution">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <InfoBar x:Name="ErrorBar" Grid.Row="0" Severity="Error" IsOpen="False" IsClosable="True" Title="A.V.I.D. couldn’t complete the operation"/>
        <Grid Grid.Row="1" ColumnSpacing="24" Padding="28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="470"/><ColumnDefinition Width="2*" MinWidth="340"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Create a video" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                        <TextBlock Text="Combine one image with an audio recording for social media distribution." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" AllowDrop="True" DragOver="MediaDragOver" Drop="ImageDrop">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Source media" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Image" VerticalAlignment="Center"/><TextBox x:Name="ImagePath" Grid.Column="1" IsReadOnly="True" PlaceholderText="Nothing selected" AutomationProperties.Name="Selected image"/><Button Grid.Column="2" Content="Choose…" Click="ChooseImage" AutomationProperties.Name="Choose image"/>
                            </Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Audio" VerticalAlignment="Center"/><TextBox x:Name="AudioPath" Grid.Column="1" IsReadOnly="True" PlaceholderText="Nothing selected" AutomationProperties.Name="Selected audio"/><Button Grid.Column="2" Content="Choose…" Click="ChooseAudio" AutomationProperties.Name="Choose audio"/>
                            </Grid>
                            <TextBlock x:Name="DurationText" Text="No audio selected" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Format" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <ComboBox x:Name="PlatformBox" Header="Social media outlet" SelectionChanged="PlatformChanged" AutomationProperties.Name="Social media outlet"/>
                            <ComboBox x:Name="AspectBox" Header="Aspect ratio" SelectionChanged="AspectChanged" AutomationProperties.Name="Aspect ratio"/>
                            <ComboBox x:Name="ResolutionBox" Header="Resolution" SelectionChanged="PreviewOptionsChanged" AutomationProperties.Name="Resolution"/>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="BitrateBox" Header="Audio bitrate" Text="128k" AutomationProperties.HelpText="Enter a value such as 128k"/>
                                <NumberBox x:Name="FpsBox" Grid.Column="1" Header="Frames per second" Value="30" Minimum="1" Maximum="240" SpinButtonPlacementMode="Compact"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="18"><CheckBox x:Name="FlipHorizontal" Content="Flip horizontally" Click="PreviewOptionsChanged"/><CheckBox x:Name="FlipVertical" Content="Flip vertically" Click="PreviewOptionsChanged"/></StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10"><TextBlock Text="Destination" Style="{ThemeResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputPath" IsReadOnly="True" PlaceholderText="Choose an MP4 destination" AutomationProperties.Name="Output video"/><Button Grid.Column="1" Content="Choose…" Click="ChooseOutput" AutomationProperties.Name="Choose output video"/></Grid></StackPanel>
                    </Border>
                    <Button x:Name="RenderButton" Content="Create Video" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="RenderOrCancel" IsEnabled="False" AutomationProperties.HelpText="Create an MP4 video"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Spacing="14">
                <TextBlock Text="Preview" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" MinHeight="380" Padding="18">
                    <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Video frame preview"/>
                </Border>
                <TextBlock x:Name="PreviewCaption" Text="Choose an image to see a styled preview." TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Padding="18,10" Spacing="6"><ProgressBar x:Name="RenderProgress" Minimum="0" Maximum="1" Value="0"/><TextBlock x:Name="StatusText" Text="Loading media engine…" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    </Grid>
</Window>
