.DS_Store

# Native build output
/target/
/build/
/dist/
/packages/
/platform/macos/.build/
/platform/transcription-helper/.build/
/platform/transcription-helper/.swiftpm/
# CMake and Qt output (build/ covers standard outputs)
.qt/
CMakeUserPresets.json

# Python build-tool bytecode (the application has no Python runtime)
__pycache__/
*.py[cod]

# Local qualification notes must never be published.
/.codex/local-audits/

# Local diagnostic reports are not release source.
/reports/
